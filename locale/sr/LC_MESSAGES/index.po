#: index.php:144 index.php:285
msgid "Create bootable USB drives the easy way"
msgstr "Napravite bootable USB diskove na jednostavan način"

#: index.php:229
msgid "Change language:"
msgstr "Izaberi jezik:"

#: index.php:238
msgid "Want to improve this translation?"
msgstr "Želite da poboljšate prevod?"

