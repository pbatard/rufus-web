\pard\ltrpar\sl276\slmult1\b\f0\fs22\lang9\tab Rufus 4.10 BETA (2025.09.10)\fs10\b0\par\fs22\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\ltrpar\fi-360\li720\sl276\slmult1\fs16 Add Dark Mode support (courtesy of @ozone10)\par
{\pntext\f2\'B7\tab}Add support for creating Windows CA 2023 compatible media (requires a Windows 11 25H2 ISO)\par
{\pntext\f2\'B7\tab}Add support for saving an existing drive to ISO (UDF only)\par
{\pntext\f2\'B7\tab}Improve error reporting when saving to VHD/VHDX (with thanks to @Kazkans)\par
{\pntext\f2\'B7\tab}Fix UEFI DBX updates being reported in some timezones, even when there are none\par
{\pntext\f2\'B7\tab}Fix a situation where no file system can be selected in ISO mode\par
{\pntext\f2\'B7\tab}Fix a crash when trying to process Windows ISOs with very long paths\par

\pard\ltrpar\sl276\slmult1\par
