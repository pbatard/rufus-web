#: index.php:453
msgid "Changelog"
msgstr "චේන්ලොග්"

#: index.php:279 index.php:485
msgid "Source Code"
msgstr "ප්රභව කේතය"

#: index.php:487
#, php-format
msgid ""
"Alternatively, you can clone the <a target=\"_blank\" %s>git</a> repository "
"using:"
msgstr ""
"විකල්පයක් ලෙස, ඔබට මෙය භාවිතා කරමින් <a target=\"_blank\" %s> git </a> නිධිය"
