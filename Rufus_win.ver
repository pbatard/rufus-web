\pard\ltrpar\sl276\slmult1\par\b\f0\fs22\lang9\tab Rufus 4.7 (2025.04.09)\b0\par\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\ltrpar\fi-360\li720\sl276\slmult1\fs16 Add a mechanism to detect and download updated DBXs from the official UEFI repository\par
{\pntext\f2\'B7\tab}Add ztsd compression support for disk images\par
{\pntext\f2\'B7\tab}Add a new exclusion feature in the settings, to ignore disks with a specific GPT GUID\par
{\pntext\f2\'B7\tab}Improve detection for compressed VHD images that are too large to fit the target drive\par
{\pntext\f2\'B7\tab}Fix commandline hogger not being deleted when running Rufus from a different directory\par
{\pntext\f2\'B7\tab}Fix FAT filenames from embedded images being potentially truncated on image extraction\par
{\pntext\f2\'B7\tab}Fix a side-loading vulnerability [CVE-2025-26624] with cfgmgr32.dll\par
{\pntext\f2\'B7\tab}Fix UI memory leaks\par
{\pntext\f2\'B7\tab}Fall back to user/system default locale when getting error description\par
{\pntext\f2\'B7\tab}Don't run the commandline hogger on POSIX shells\par
{\pntext\f2\'B7\tab}Drop ARM 32-bit builds (Note that ARM 64-bit builds are *NOT* affected by this)\par
{\pntext\f2\'B7\tab}Update FreeDOS and Grub4DOS to latest\par

\pard\ltrpar\sl276\slmult1\par}
