#: index.php:379
msgid "Windows 8 or later."
msgstr "Windows 8 ya da üstü, 32 ya da 64 bit farketmeden destekler."

#: index.php:379
msgid "Once downloaded, the application is ready to use."
msgstr "İndirildikten sonra, uygulama kullanıma hazırdır."

#: index.php:380
